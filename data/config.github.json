{
  "ai": {
    "provider": "openai",
    "provider_chain": null,
    "model": "gpt-6-luna",
    "base_url": null,
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 0.0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "languages": [
      "en"
    ],
    "azure_endpoint_env": null,
    "api_version": null
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 50,
      "category": "technology",
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai",
        "content_extractor": null,
        "profile": [
          "tech-news",
          "tech-blog"
        ]
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "ai",
        "content_extractor": null,
        "profile": [
          "tech-news",
          "tech-blog"
        ]
      },
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "ai",
        "content_extractor": null,
        "profile": "tech-news"
      },
      {
        "name": "Google Research Blog",
        "url": "https://research.google/blog/rss/",
        "enabled": true,
        "category": "ai",
        "content_extractor": null,
        "profile": [
          "tech-news",
          "tech-blog"
        ]
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mkusaka.github.io/trending/all/daily/index.xml",
        "enabled": true,
        "category": "technology",
        "content_extractor": null,
        "profile": "tech-news"
      },
      {
        "name": "Financial Times Markets",
        "url": "https://www.ft.com/markets?format=rss",
        "enabled": true,
        "fetch_limit": 12,
        "category": "finance",
        "content_extractor": null,
        "profile": "finance-news"
      },
      {
        "name": "CBS Sports NBA",
        "url": "https://www.cbssports.com/rss/headlines/nba/",
        "enabled": true,
        "fetch_limit": 12,
        "category": "nba",
        "content_extractor": null,
        "profile": "sports-news"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "cscareerquestions",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 20,
          "category": "technology",
          "profile": "career-advice"
        },
        {
          "subreddit": "technology",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 60,
          "category": "technology",
          "profile": "tech-news"
        },
        {
          "subreddit": "stocks",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 20,
          "category": "finance",
          "profile": "finance-news"
        },
        {
          "subreddit": "personalfinance",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 20,
          "category": "finance",
          "profile": "finance-news"
        },
        {
          "subreddit": "wallstreetbets",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 60,
          "category": "finance",
          "profile": "finance-news"
        },
        {
          "subreddit": "nba",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 60,
          "category": "nba",
          "profile": "sports-news"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": false
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 23,
    "fill_from_reserve": true,
    "category_groups": {
      "ai": {
        "name": "AI",
        "limit": 6,
        "categories": [
          "ai"
        ]
      },
      "technology": {
        "name": "Technology",
        "limit": 5,
        "categories": [
          "technology"
        ]
      },
      "finance": {
        "name": "Stocks and Finance",
        "limit": 6,
        "categories": [
          "finance"
        ]
      },
      "nba": {
        "name": "NBA",
        "limit": 4,
        "categories": [
          "nba"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "career-advice",
      "finance-news",
      "sports-news"
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "sports-news": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "career-advice": {
        "threshold": 6.0,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "extractors": {},
  "email": null,
  "webhook": null,
  "wechat": null
}
